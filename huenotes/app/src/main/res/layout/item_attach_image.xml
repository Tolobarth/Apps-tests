<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:clickable="true" android:focusable="true"
    app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:id="@+id/img" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:maxHeight="360dp" android:minHeight="96dp"
            android:scaleType="fitCenter" android:importantForAccessibility="no" />
        <ImageButton android:id="@+id/remove" android:layout_width="36dp" android:layout_height="36dp"
            android:layout_gravity="top|end" android:layout_margin="8dp" android:background="@drawable/scrim_circle"
            android:src="@drawable/ic_close" android:tint="#FFFFFF" android:contentDescription="@string/cd_remove_attachment" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
