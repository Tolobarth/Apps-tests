<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editorRoot" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent" app:navigationIcon="@drawable/ic_back"
        app:navigationContentDescription="@string/cd_back" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="24dp">
            <EditText android:id="@+id/titleEdit" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@null" android:hint="@string/hint_title" android:textSize="26sp" android:textStyle="bold"
                android:fontFamily="sans-serif-medium" android:textColor="@color/note_text"
                android:textColorHint="@color/note_text_variant" android:inputType="textCapSentences|textMultiLine"
                android:paddingTop="4dp" android:paddingBottom="4dp" />
            <TextView android:id="@+id/meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/note_text_variant" android:layout_marginBottom="8dp" />
            <com.google.android.material.chip.Chip android:id="@+id/reminderChip"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:visibility="gone" app:chipIcon="@drawable/ic_alarm" app:closeIconVisible="true"
                app:closeIcon="@drawable/ic_close" android:layout_marginBottom="8dp" />
            <LinearLayout android:id="@+id/attachments" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
            <EditText android:id="@+id/bodyEdit" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="200dp" android:background="@null" android:gravity="top" android:hint="@string/hint_body"
                android:textSize="17sp" android:lineSpacingMultiplier="1.25" android:textColor="@color/note_text"
                android:textColorHint="@color/note_text_variant" android:inputType="textCapSentences|textMultiLine" />
            <LinearLayout android:id="@+id/checklist" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="6dp" android:paddingBottom="6dp">
        <ImageButton android:id="@+id/checklistButton" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_checklist"
            android:tint="@color/note_text" android:contentDescription="@string/cd_toggle_checklist" />
        <ImageButton android:id="@+id/reminderButton" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_alarm"
            android:tint="@color/note_text" android:contentDescription="@string/cd_set_reminder" />
        <ImageButton android:id="@+id/imageButton" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_image"
            android:tint="@color/note_text" android:contentDescription="@string/cd_add_image" />
        <ImageButton android:id="@+id/drawButton" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_brush"
            android:tint="@color/note_text" android:contentDescription="@string/cd_add_drawing" />
        <ImageButton android:id="@+id/micButton" android:layout_width="48dp" android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_mic"
            android:tint="@color/note_text" android:contentDescription="@string/cd_add_audio" />
        <HorizontalScrollView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:scrollbars="none" android:layout_marginStart="8dp">
            <LinearLayout android:id="@+id/swatches" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" />
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
